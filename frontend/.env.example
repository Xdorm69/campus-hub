# Base URL of the backend API, including the version prefix
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# GIF picker (optional — the GIF button is hidden when no key is set).
# "klipy" (free; get a key at https://partner.klipy.com) or "giphy".
# The key is public on purpose: both providers require searches to be made
# from the browser.
NEXT_PUBLIC_GIF_PROVIDER=klipy
NEXT_PUBLIC_GIF_API_KEY=
