PORT=4000
NODE_ENV=local
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/campushub

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN_HOURS=168
BCRYPT_ROUNDS=10

# Origin of the Next.js app (CORS + cookies)
FRONTEND_URL=http://localhost:3000

# Public origin of this API (no /api/v1). In production: https://your-api.onrender.com
PUBLIC_URL=http://localhost:4000

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@campushub.dev
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_USERNAME=admin

# Voice notes & videos (storage guards; defaults keep both under 250 MB)
VOICE_DAILY_LIMIT_MB=5
VOICE_STORAGE_LIMIT_MB=100
VOICE_RETENTION_DAYS=30
VIDEO_DAILY_LIMIT_MB=30
VIDEO_STORAGE_LIMIT_MB=150
VIDEO_RETENTION_DAYS=30
