PORT=4000
NODE_ENV=local
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/campushub

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN_HOURS=168
BCRYPT_ROUNDS=10

# Origin of the Next.js app (CORS + cookies)
FRONTEND_URL=http://localhost:3000

# Public origin of this API; used to build URLs for uploaded files
PUBLIC_URL=http://localhost:4000
# Where multer stores uploads (relative to backend/)
UPLOAD_DIR=uploads

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@campushub.dev
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_USERNAME=admin
